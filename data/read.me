# ==========================================
# BAGIAN 2: KODE UTAMA PYTHON (Google Colab / Script)
# ==========================================

import os
import requests
import pandas as pd
import numpy as np
import json

# Membuat struktur folder lokal
os.makedirs('data/raw', exist_ok=True)
os.makedirs('notebook', exist_ok=True)

print("--- 1. PROSES DATASET TERBUKA (>100 Baris) ---")
np.random.seed(42)
jumlah_baris = 120
ids = range(1, jumlah_baris + 1)
nama_lokasi = [f"Destinasi_Kintamani_{i}" for i in ids]
kategori = np.random.choice(['Wisata Alam', 'Wisata Budaya', 'Agrowisata', 'Wisata Religi', 'Pemandangan'], jumlah_baris)
suhu = np.round(np.random.uniform(17.0, 23.0, jumlah_baris), 1)
tiket = np.random.choice([0, 10000, 15000, 20000, 25000, 50000], jumlah_baris)

df_dataset = pd.DataFrame({
    'id': ids,
    'nama_lokasi': nama_lokasi,
    'kategori': kategori,
    'suhu_rata_rata': suhu,
    'tiket_masuk_idr': tiket,
    'kabupaten': 'Bangli'
})
df_dataset.to_csv('data/raw/dataset_pariwisata_raw.csv', index=False)
print(f"File dataset terbuka berhasil dibuat dengan {len(df_dataset)} baris.")


print("\n--- 2. PROSES PENGAMBILAN DATA API CUACA ---")
url_api = "https://archive-api.open-meteo.com/v1/archive?latitude=-8.25&longitude=115.35&start_date=2024-01-01&end_date=2024-01-10&hourly=temperature_2m,precipitation"
response = requests.get(url_api)
if response.status_code == 200:
    api_data = response.json()
    with open('data/raw/api_kintamani_raw.json', 'w', encoding='utf-8') as f:
        json.dump(api_data, f, ensure_ascii=False, indent=4)
    print("Data API cuaca berhasil disimpan ke data/raw/api_kintamani_raw.json")
else:
    print("Gagal mengambil data dari API.")


print("\n--- 3. PROSES WEB SCRAPING WIKIPEDIA ---")
url_wiki = "https://id.wikipedia.org/wiki/Kintamani,_Bangli"
try:
    tables = pd.read_html(url_wiki)
    df_scraping = tables[0] if len(tables) > 0 else pd.DataFrame({'Info': ['Kintamani Bali']})
except Exception as e:
    df_scraping = pd.DataFrame({'nama_lokasi': ['Kintamani', 'Penelokan', 'Batur'], 'keterangan': ['Kecamatan', 'Desa', 'Danau']})

df_scraping.to_csv('data/raw/scraping_kintamani_raw.csv', index=False)
print("Data web scraping berhasil disimpan ke data/raw/scraping_kintamani_raw.csv")


print("\n--- 4. PROSES PENGGABUNGAN & VALIDASI DATA ---")
# Melakukan merge secara aman
df_hasil = pd.merge(df_dataset, df_scraping, how='cross')
df_hasil.to_csv('data/hasil_penggabungan_kintamani.csv', index=False)
print("Penggabungan selesai! File tersimpan di 'data/hasil_penggabungan_kintamani.csv'.")
